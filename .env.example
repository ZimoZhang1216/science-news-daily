# Shared by the report runner and dashboard recommendations. Dashboard recommendations do not
# fall back when the selected provider's model key is missing or unusable.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional OpenAI fallback/configuration. Leave blank unless you use OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional polite API metadata.
NCBI_EMAIL=
CROSSREF_MAILTO=
# OpenAlex is used by the broad fourteen-discipline catalogue. Create a free API key at
# https://openalex.org/settings/api; leave blank only when you do not enable the OpenAlex source.
OPENALEX_API_KEY=
# Optional. Used only for public GitHub release lookups; never sent to other sources.
GITHUB_SOURCE_TOKEN=
REPORT_PROFILE=chemistry
CHEM_NEWS_MAX_ITEMS=30
CHEM_NEWS_MAX_AI_ITEMS=30

# Email delivery. Use an SMTP authorization code/app password, not your web login password.
# Multiple recipients are supported. Separate addresses with commas or semicolons.
# Chemistry uses CHEM_REPORT_EMAIL_TO first, then REPORT_EMAIL_TO for backward compatibility.
REPORT_EMAIL_TO=2510248@mail.nankai.edu.cn
CHEM_REPORT_EMAIL_TO=
BIO_REPORT_EMAIL_TO=
STAT_REPORT_EMAIL_TO=
BUSINESS_REPORT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=ssl
EMAIL_ENABLED=true

# Optional PDF conversion settings. Required only if LibreOffice is not in PATH.
LIBREOFFICE_PATH=
PDF_CONVERT_TIMEOUT=120

# Local personal operations dashboard. Keep values in your private .env only.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Bounded automatic personalised delivery. GitHub Actions may set the same names as repository variables.
MAX_JOBS_PER_RUN=10
MAX_RUNTIME_MINUTES=80
CUSTOM_DELIVERY_LEASE_MINUTES=120
# Optional local cache path for the dashboard's Turso replica. Leave blank to use the macOS
# application-support default. The file is local-only and should not be committed.
PERSONAL_ADMIN_REPLICA_PATH=
PERSONAL_ADMIN_GITHUB_REPOSITORY=
GITHUB_DISPATCH_TOKEN=
